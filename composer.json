{
  "name": "workbunny/mysql-protocol",
  "type": "library",
  "license": "Apache-2.0",
  "description": "The MySQL protocol implemented by PHP",
  "authors": [
    {
      "name": "chaz6chez",
      "email": "chaz6chez1993@outlook.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "workerman/workerman": "^4.0 | ^5.0",
    "symfony/var-dumper": "^6.0 | ^7.0",
    "phpunit/phpunit": "^10.0 | ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Workbunny\\MysqlProtocol\\": "src",
      "Protocols\\" : "protocols"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Workbunny\\MysqlProtocol\\Tests\\": "tests"
    }
  },
  "suggest": {
    "workerman/workerman": "workerman implementation supporting the MySQL protocol"
  },
  "scripts": {
    "test": "phpunit"
  }
}